<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>
    <i class="bi bi-people"></i> Customers
  </h2>
  <span class="badge bg-primary fs-6"><%= @customers.total_count %> total</span>
</div>

<% if @customers.any? %>
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Product Code</th>
              <th>Subject</th>
              <th>Created At</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @customers.each do |customer| %>
              <tr>
                <td><%= customer.id %></td>
                <td><strong><%= customer.name %></strong></td>
                <td>
                  <% if customer.email.present? %>
                    <a href="mailto:<%= customer.email %>"><%= customer.email %></a>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td>
                  <% if customer.phone.present? %>
                    <%= customer.phone %>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td>
                  <% if customer.product_code.present? %>
                    <span class="badge bg-info"><%= customer.product_code %></span>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td><%= customer.subject&.truncate(40) || '-' %></td>
                <td><%= customer.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td>
                  <%= link_to "View", customer_path(customer), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= paginate @customers, theme: 'twitter-bootstrap-5' %>
  </div>
<% else %>
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    No customers found. Upload some email files to get started!
  </div>
<% end %>
