<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>
    <i class="bi bi-file-earmark-text"></i> Processing Logs
  </h2>
</div>

<div class="row mb-4">
  <div class="col-md-4">
    <div class="card text-center shadow-sm">
      <div class="card-body">
        <h3 class="text-primary"><%= @stats[:total] %></h3>
        <p class="text-muted mb-0">Total Processed</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center shadow-sm">
      <div class="card-body">
        <h3 class="text-success"><%= @stats[:successful] %></h3>
        <p class="text-muted mb-0">Successful</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center shadow-sm">
      <div class="card-body">
        <h3 class="text-danger"><%= @stats[:failed] %></h3>
        <p class="text-muted mb-0">Failed</p>
      </div>
    </div>
  </div>
</div>

<% if @logs.any? %>
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Status</th>
              <th>Filename</th>
              <th>Sender</th>
              <th>Customer</th>
              <th>Processed At</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @logs.each do |log| %>
              <tr>
                <td>
                  <span class="badge bg-<%= log.success? ? 'success' : 'danger' %>">
                    <%= log.status.upcase %>
                  </span>
                </td>
                <td><%= log.filename %></td>
                <td><%= log.sender || '-' %></td>
                <td>
                  <% if log.customer %>
                    <%= link_to log.customer.name, customer_path(log.customer) %>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td><%= log.processed_at&.strftime("%Y-%m-%d %H:%M") || '-' %></td>
                <td>
                  <%= link_to "Details", processing_log_path(log), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= paginate @logs %>
  </div>
<% else %>
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    No processing logs found. Upload some email files to get started!
  </div>
<% end %>
