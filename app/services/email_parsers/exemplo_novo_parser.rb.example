# frozen_string_literal: true

# EXEMPLO: Como criar um novo parser
# Este arquivo demonstra como adicionar suporte para um novo remetente

module EmailParsers
  # Parser de exemplo para um novo fornecedor
  # Descomente e adapte conforme necessário
  class ExemploNovoParser < BaseParser
    def extract_customer_info
      body_text = body

      {
        name: extract_name(body_text),
        email: extract_email_field(body_text),
        phone: extract_phone_field(body_text),
        product_code: extract_product_code_field(body_text),
        subject: subject
      }
    end

    private

    # Adapte os métodos abaixo conforme o formato do email
    
    def extract_name(text)
      # Exemplo: procurar por "Nome:" ou "Cliente:"
      name_match = text.match(/(?:Nome|Cliente):\s*(.+?)(?:\n|$)/i)
      name_match[1].strip if name_match
    end

    def extract_email_field(text)
      # Exemplo: procurar por "Email:" ou usar extração genérica
      email_match = text.match(/E-?mail:\s*(.+?)(?:\n|$)/i)
      if email_match
        email_match[1].strip
      else
        # Fallback para extração genérica
        extract_email(text)
      end
    end

    def extract_phone_field(text)
      # Exemplo: procurar por "Telefone:" ou "Tel:"
      phone_match = text.match(/(?:Telefone|Tel):\s*(.+?)(?:\n|$)/i)
      if phone_match
        phone_match[1].strip
      else
        # Fallback para extração genérica
        extract_phone(text)
      end
    end

    def extract_product_code_field(text)
      # Exemplo: procurar por "Produto:" ou "Código:"
      product_match = text.match(/(?:Produto|Código):\s*(.+?)(?:\n|$)/i)
      if product_match
        product_match[1].strip
      else
        # Fallback para extração genérica
        extract_product_code(text)
      end
    end
  end
end
